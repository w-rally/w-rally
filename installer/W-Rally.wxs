<!--
  W-Rally's installer (WiX 5; built by installer/build-msi.ps1 from the files CMake's install step staged).
  - Installs per machine to Program Files\W-Rally (changeable), a Start menu shortcut.
  - Asks for the Richard Burns Rally folder, pre-filled with the one found (ca/rbr_folder.cpp: DetectRbr), and goes on
    only with a real one (ValidateRbr): W-Rally has no content of its own yet. A silent install takes RBRDIR=<folder>
    or the one found, and fails without one.
  - The folder goes to install.ini beside the exe (rbr_path, read by the game before the user's W-Rally.ini) and to
    HKLM\Software\W-Rally (RbrPath), where an upgrade finds it again.
  - Then asks for the downloads folder (docs/content-layers.md: the downloaded layer, the one the game writes),
    pre-filled with this user's LocalAppData\W-Rally\Downloads (ca: DefaultDownloads). install.ini's download_path and
    the registry's DownloadPath keep "%LOCALAPPDATA%\W-Rally\Downloads" when that default is kept - the game expands
    it, each Windows user their own - else the folder chosen (ca: DownloadPath). A silent install takes
    DOWNLOADDIR=<folder>. Each user can set their own in the game's Settings.
-->
<!-- The name as the game's corner shows the build: "W-Rally <version> · <commit>" (build-msi.ps1 passes both). -->
<?if $(var.Commit) != "" ?>
<?define ProductName = "W-Rally $(var.Version) · $(var.Commit)" ?>
<?else?>
<?define ProductName = "W-Rally $(var.Version)" ?>
<?endif?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="$(var.ProductName)" Manufacturer="W-Rally" Version="$(var.Version)" UpgradeCode="93B65FF8-4655-40B1-A738-C49E352EED8C"
           Scope="perMachine" Compressed="yes" Codepage="1252">
    <!-- Every build is the same version for now: a newer build of it replaces the installed one (same-version upgrade). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer version of W-Rally is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/w-rally/w-rally" />
    <Property Id="ARPNOMODIFY" Value="1" />

    <!-- The RBR folder: the last install's, else DetectRbr's (RBRDIR is a directory so the Browse dialog can set it). -->
    <Property Id="RBRDIR" Secure="yes">
      <RegistrySearch Root="HKLM" Key="Software\W-Rally" Name="RbrPath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="RBRPATH" Secure="yes" />
    <!-- The downloads folder: the last install's (DownloadPath), else DefaultDownloads' (a directory, as RBRDIR). -->
    <Property Id="DOWNLOADDIR" Secure="yes">
      <RegistrySearch Root="HKLM" Key="Software\W-Rally" Name="DownloadPath" Type="raw" Bitness="always64" />
    </Property>
    <Property Id="DOWNLOADPATH" Secure="yes" />
    <Property Id="RBR_VALID" Secure="yes" />

    <Binary Id="RbrFolderCA" SourceFile="$(var.CaDll)" />
    <CustomAction Id="DetectRbr" BinaryRef="RbrFolderCA" DllEntry="DetectRbr" Execute="immediate" Return="check" />
    <CustomAction Id="ValidateRbr" BinaryRef="RbrFolderCA" DllEntry="ValidateRbr" Execute="immediate" Return="check" />
    <CustomAction Id="DefaultDownloads" BinaryRef="RbrFolderCA" DllEntry="DefaultDownloads" Execute="immediate" Return="check" />
    <CustomAction Id="DownloadPath" BinaryRef="RbrFolderCA" DllEntry="DownloadPath" Execute="immediate" Return="check" />
    <CustomAction Id="RbrMissing" Error="W-Rally needs Richard Burns Rally: no RBR folder was found. Install with RBRDIR=&quot;&lt;the RBR folder&gt;&quot;." />

    <InstallUISequence>
      <Custom Action="DetectRbr" After="AppSearch" Condition="NOT Installed" />
      <Custom Action="DefaultDownloads" After="DetectRbr" />
    </InstallUISequence>
    <InstallExecuteSequence>
      <Custom Action="DetectRbr" After="AppSearch" Condition="NOT Installed" />
      <Custom Action="ValidateRbr" After="DetectRbr" Condition="NOT Installed" />
      <Custom Action="RbrMissing" After="ValidateRbr" Condition="NOT Installed AND RBR_VALID&lt;&gt;&quot;1&quot;" />
      <Custom Action="DefaultDownloads" After="RbrMissing" />
      <Custom Action="DownloadPath" After="CostFinalize" />
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="W-Rally" />
    </StandardDirectory>
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="RBRDIR" Name="Richard Burns Rally" />
      <Directory Id="DOWNLOADDIR" Name="Downloads" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <ComponentGroup Id="Game" Directory="INSTALLFOLDER">
      <Files Include="$(var.StageDir)\**" />
    </ComponentGroup>

    <Component Id="RbrSettings" Directory="INSTALLFOLDER" Guid="7C1E5B2A-3F4D-4E8B-9A6C-2D1F0E3B4A51">
      <RegistryValue Root="HKLM" Key="Software\W-Rally" Name="RbrPath" Type="string" Value="[RBRPATH]" KeyPath="yes" />
      <IniFile Id="InstallIni" Action="addLine" Directory="INSTALLFOLDER" Name="install.ini" Section="W-Rally"
               Key="rbr_path" Value="[RBRPATH]" />
      <RegistryValue Root="HKLM" Key="Software\W-Rally" Name="DownloadPath" Type="string" Value="[DOWNLOADPATH]" />
      <IniFile Id="InstallIniDownloads" Action="addLine" Directory="INSTALLFOLDER" Name="install.ini" Section="W-Rally"
               Key="download_path" Value="[DOWNLOADPATH]" />
    </Component>

    <Component Id="StartMenu" Directory="ProgramMenuFolder" Guid="5E2F8C1D-9B3A-4C7E-8D6F-1A2B3C4D5E61">
      <Shortcut Id="WRallyShortcut" Name="W-Rally" Description="A rally simulator created by the community"
                Target="[INSTALLFOLDER]W-Rally.exe" WorkingDirectory="INSTALLFOLDER" />
      <RegistryValue Root="HKLM" Key="Software\W-Rally" Name="StartMenu" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="W-Rally">
      <ComponentGroupRef Id="Game" />
      <ComponentRef Id="RbrSettings" />
      <ComponentRef Id="StartMenu" />
    </Feature>

    <UIRef Id="WRallyUI" />
  </Package>

  <Fragment>
    <!-- WixUI_InstallDir's flow with the RBR folder after the install folder, and no licence page. -->
    <UI Id="WRallyUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
      <Property Id="WIXUI_DONTVALIDATEPATH" Value="1" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="RbrDirDlg" Order="4" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="RbrDirDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" />
      <Publish Dialog="RbrDirDlg" Control="Next" Event="SetTargetPath" Value="RBRDIR" Order="1" />
      <Publish Dialog="RbrDirDlg" Control="Next" Event="DoAction" Value="ValidateRbr" Order="2" />
      <Publish Dialog="RbrDirDlg" Control="Next" Event="SpawnDialog" Value="RbrInvalidDlg" Order="3" Condition="RBR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="RbrDirDlg" Control="Next" Event="NewDialog" Value="DownloadDirDlg" Order="4" Condition="RBR_VALID=&quot;1&quot;" />
      <Publish Dialog="RbrDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="RBRDIR" Order="1" />
      <Publish Dialog="RbrDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="DownloadDirDlg" Control="Back" Event="NewDialog" Value="RbrDirDlg" />
      <Publish Dialog="DownloadDirDlg" Control="Next" Event="SetTargetPath" Value="DOWNLOADDIR" Order="1" />
      <Publish Dialog="DownloadDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" />
      <Publish Dialog="DownloadDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="DOWNLOADDIR" Order="1" />
      <Publish Dialog="DownloadDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="DownloadDirDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <!-- The RBR folder: InstallDirDlg's layout. -->
      <Dialog Id="RbrDirDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Where Richard Burns Rally is installed." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Richard Burns Rally folder" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Info" Type="Text" X="20" Y="60" Width="320" Height="45" NoPrefix="yes"
                 Text="W-Rally has no stages and cars of its own yet: it uses those of your Richard Burns Rally, read in place and never changed. Choose the folder with RichardBurnsRally_SSE.exe." />
        <Control Id="FolderLabel" Type="Text" X="20" Y="110" Width="320" Height="12" NoPrefix="yes" Text="RBR folder:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="124" Width="320" Height="18" Property="RBRDIR" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="148" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)" />
      </Dialog>

      <!-- The downloads folder: RbrDirDlg's layout. -->
      <Dialog Id="DownloadDirDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Where W-Rally keeps what it downloads." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Downloads folder" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Info" Type="Text" X="20" Y="60" Width="320" Height="45" NoPrefix="yes"
                 Text="Stages, cars and their physics downloaded, each version in a folder of its own - they can take a lot of room. Kept, this folder is each Windows user's own; each can choose another in the game's Settings." />
        <Control Id="FolderLabel" Type="Text" X="20" Y="110" Width="320" Height="12" NoPrefix="yes" Text="Downloads folder:" />
        <Control Id="Folder" Type="PathEdit" X="20" Y="124" Width="320" Height="18" Property="DOWNLOADDIR" />
        <Control Id="ChangeFolder" Type="PushButton" X="20" Y="148" Width="56" Height="17" Text="!(loc.InstallDirDlgChange)" />
      </Dialog>

      <Dialog Id="RbrInvalidDlg" Width="260" Height="105" Title="!(loc.InvalidDirDlg_Title)">
        <Control Id="OK" Type="PushButton" X="102" Y="80" Width="56" Height="17" Default="yes" Cancel="yes" Text="!(loc.WixUIOK)">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Text" Type="Text" X="48" Y="15" Width="194" Height="58" NoPrefix="yes"
                 Text="This is not a Richard Burns Rally folder: it needs RichardBurnsRally_SSE.exe, Physics.rbz, Maps\Tracks.ini and Cars\Cars.ini. W-Rally cannot be installed without them." />
        <Control Id="Icon" Type="Icon" X="15" Y="15" Width="24" Height="24" FixedSize="yes" IconSize="32" Text="!(loc.InvalidDirDlgIcon)" />
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />
  </Fragment>
</Wix>
